[Unit]
Description=Mist License Transfer (web)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/pi/mist-license-transfer-web
ExecStart=/home/pi/mist-license-transfer-web/.venv/bin/python3 app.py
Restart=on-failure
RestartSec=5
User=pi
# The app refuses to start if web.conf is missing or invalid; see the journal.

[Install]
WantedBy=multi-user.target
